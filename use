{
    TMP_SCRIPT=$(mktemp)
    awk '/LAUNCHER_END/{flag=1; next} flag' > "$TMP_SCRIPT"
    exec sh "$TMP_SCRIPT"  "$TMP_SCRIPT"  >&2
} << 'LAUNCHER_END'

# LAUNCHER_END
if [ "$DEBUG" = "1" ]; then
    echo "=== DEBUG MODE ENABLED ===" >&2
    echo "Notice: Script hash verification will be bypassed." >&2 
fi

EXPECTED_HASH="17d24a6432dbb9bbe31167e35d0f772d0b2ea19179c5f0c62b18ed731f154e84"

calc_self_sha256() {
    local target_file="$1"
    local start_line
    start_line=$(grep -n "ACTUAL_START" "$target_file" | grep -v "grep" | cut -d':' -f1 | head -n 1 | tr -d '\r\n ')
    if [ -z "$start_line" ]; then
        return 1
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        tail -n +"$start_line" "$target_file" | sha256sum | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        tail -n +"$start_line" "$target_file" | shasum -a 256 | cut -d' ' -f1
    else
        return 1
    fi
}

CURRENT_HASH=$(calc_self_sha256 "$1")

if [ $? -ne 0 ]; then
    echo "[ERROR] SHA-256 command not found in the system." >&2
    exit 1
fi

if [ "$CURRENT_HASH" != "$EXPECTED_HASH" ]; then
    if [ "$DEBUG" = "1" ]; then
        echo "[WARNING] Hash mismatch detected. Proceeding anyway due to active debug mode." >&2
        echo "  Expected: $EXPECTED_HASH" >&2
        echo "  Current:  $CURRENT_HASH" >&2
    else
        echo "[ERROR] SHA-256 hash verification failed. Aborting execution." >&2
        exit 1
    fi
fi

# ACTUAL_START
echo ""

BOLD=$(printf '\033[1m')
RED=$(printf '\033[1;31m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
CYAN=$(printf '\033[1;36m')
RESET=$(printf '\033[0m')

if printf "%s" "$LANG$LC_ALL" | grep -qi "ja"; then
    IS_JA=1
else
    IS_JA=0
fi

msg_start_ja="${BOLD}[INFO] CVE-2026-109618 / CVE-2026-109619 (PHP脆弱性/2026年10月21日) の簡易診断を開始します...${RESET}"
msg_start_en="${BOLD}[INFO] Starting integrity check for CVE-2026-109618 / CVE-2026-109619 (PHP Vulnerabilities: Oct 21, 2026)...${RESET}"

msg_no_php_ja="${CYAN}判定結果: 影響なし (PHP未導入)${RESET}"
msg_no_php_en="${CYAN}Result: No Impact (PHP is not installed)${RESET}"

msg_current_php_ja="現在のPHPバージョン: %s"
msg_current_php_en="Current PHP version: %s"

msg_php_match_ja="${RED}【警告】対象の脆弱性バージョン（未対策）に合致しました。アップデートが必要です。${RESET}"
msg_php_match_en="${RED}[WARNING] Target vulnerability version matched. Update (Restart) required.${RESET}"
msg_php_mismatch_ja="${CYAN}判定結果: 影響なし (現在のPHPバージョンは対策済みです)${RESET}"
msg_php_mismatch_en="${CYAN}Result: No Impact (Current PHP version is secure)${RESET}"

msg_confirm_ja="${YELLOW}アップデートしますか (PHPとApacheの再起動を伴います)${RESET}"
msg_confirm_en="${YELLOW}Do you want to apply the update? (This will restart Apache and PHP)${RESET}"
msg_cancel_ja="再起動をキャンセルしました。"
msg_cancel_en="Restart process canceled."

msg_no_perm_ja="${RED}エラー: サービスの再起動およびアップデートには管理者権限（sudo）が必要です。rootユーザーで実行するか、sudoを使用してください。${RESET}"
msg_no_perm_en="${RED}Error: Administrator privileges (sudo) are required to restart services and update. Please run as root or use sudo.${RESET}"

msg_exec_restart_ja="${BOLD}[EXEC] 以下のコマンドを実行してパッケージの更新およびサービスの再起動を行います:${RESET}"
msg_exec_restart_en="${BOLD}[EXEC] Executing the following commands for package updates and service restarts:${RESET}"

msg_apt_update_ja="パッケージインデックスを更新中 (%s)..."
msg_apt_update_en="Updating package index (%s)..."
msg_apt_install_ja="PHP関連パッケージをアップデート中 (%s)..."
msg_apt_install_en="Upgrading PHP packages strictly (%s)..."

msg_web_done_ja="Apache (%s) を再起動（graceful）しました。"
msg_web_done_en="Apache (%s) restarted (graceful)."

msg_macos_fpm_ja="${BOLD}macOS: php-fpm のアップデートが完了しました。${RESET}"
msg_macos_fpm_en="${BOLD}macOS: php-fpm patch applied (reloaded safely).${RESET}"
msg_alpine_fpm_ja="${BOLD}Alpine: php-fpm (%s) のアップデートが完了しました。${RESET}"
msg_alpine_fpm_en="${BOLD}Alpine: php-fpm (%s) patch applied (reloaded safely).${RESET}"
msg_linux_fpm_ja="${BOLD}Linux: php-fpm (systemctl) へのアップデートが完了しました。${RESET}"
msg_linux_fpm_en="${BOLD}Linux: php-fpm (systemctl) patch applied (reloaded safely).${RESET}"

if [ "$IS_JA" -eq 1 ]; then printf "%s\n" "$msg_start_ja"; else printf "%s\n" "$msg_start_en"; fi

# ==========================================
# 1. 環境とパッケージマネージャの特定
# ==========================================
runsudo="$(if uname -a | grep -qiE '\-ish' || uname -a | grep -qiE 'Android' || [ "$(whoami)" = "root" ]; then printf ""; else printf "sudo"; fi)";

packm=$(if uname -a | grep -qiE 'Darwin'; then printf "brew install"; elif [ -x "$(command -v apk)" ]; then printf "$runsudo apk add"; elif [ -x "$(command -v pkg)" ]; then printf "$runsudo pkg install -y"; elif [ -x "$(command -v yum)" ]; then printf "$runsudo yum -y install"; elif [ -x "$(command -v apt)" ]; then printf "$runsudo apt install -y"; fi);
updatepm=$(if uname -a | grep -qiE 'Darwin'; then printf "brew update"; elif [ -x "$(command -v apk)" ]; then printf "$runsudo apk update"; elif [ -x "$(command -v pkg)" ]; then printf "pkg update"; elif [ -x "$(command -v yum)" ]; then printf ""; elif [ -x "$(command -v apt)" ]; then printf "$runsudo apt update"; fi);

httpd=$(if [ "$(uname)" = "Darwin" ]; then echo "apachectl"; else command -v httpd >/dev/null && echo "httpd" || echo "apache2"; fi)
httpdctl=$(if [ -f "/usr/sbin/apachectl" ]; then echo "/usr/sbin/apachectl"; else echo "$httpd"; fi);
kcomm=$(if [ "$httpd" = "httpd" ]; then printf " -k "; else printf ""; fi);

printf "Setting httpd='%s' packagemanager='%s'\n\n" "$httpd" "$packm"

# ==========================================
# 2. PHPの有無とバージョンの特定
# ==========================================
if ! command -v php >/dev/null 2>&1; then
    if [ "$IS_JA" -eq 1 ]; then printf "%s\n" "$msg_no_php_ja"; else printf "%s\n" "$msg_no_php_en"; fi
    exit 0
fi

php_ver=$(php -r 'echo PHP_VERSION;')
if [ "$IS_JA" -eq 1 ]; then printf "$msg_current_php_ja\n" "$php_ver"; else printf "$msg_current_php_en\n" "$php_ver"; fi

# ==========================================
# 3. バージョン比較判定ロジック
# ==========================================
curr_major=$(printf "%s" "$php_ver" | cut -d. -f1)
curr_minor=$(printf "%s" "$php_ver" | cut -d. -f2)
curr_patch=$(printf "%s" "$php_ver" | cut -d. -f3 | cut -d- -f1)

is_vulnerable=0

case "$curr_major.$curr_minor" in
    8.5) if [ "$curr_patch" -lt 12 ]; then is_vulnerable=1; fi ;;
    8.4) if [ "$curr_patch" -lt 27 ]; then is_vulnerable=1; fi ;;
    8.3) if [ "$curr_patch" -lt 36 ]; then is_vulnerable=1; fi ;;
    8.2) if [ "$curr_patch" -lt 35 ]; then is_vulnerable=1; fi ;;
    8.1|8.0|7.*|5.*) is_vulnerable=1 ;;
esac

if [ "$is_vulnerable" -eq 1 ]; then
    if [ "$IS_JA" -eq 1 ]; then printf "%s\n\n" "$msg_php_match_ja"; else printf "%s\n\n" "$msg_php_match_en"; fi
else
    if [ "$IS_JA" -eq 1 ]; then printf "%s\n" "$msg_php_mismatch_ja"; else printf "%s" "$msg_php_mismatch_en"; fi
    echo ""
    exit 0
fi

# ==========================================
# 4. 実行予定コマンドの事前ビルド
# ==========================================
cmd_update="$updatepm"
if [ -x "$(command -v apt)" ]; then
    cmd_install="$runsudo apt install -y --only-upgrade \"php*\"";
elif uname -a | grep -qiE 'Darwin'; then
    cmd_install="brew upgrade php";
else
    cmd_install="$packm php";
fi

cmd_web=""
web_type=""

if [ "$(uname)" = "Darwin" ]; then
    if command -v apachectl >/dev/null 2>&1; then
        web_type="apachectl"
        if [ -n "$runsudo" ]; then cmd_web="sudo apachectl graceful"; else cmd_web="apachectl graceful"; fi
    fi
else
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet apache2 2>/dev/null || command -v apache2 >/dev/null 2>&1; then
            web_type="systemctl restart apache2";
            cmd_web="$runsudo systemctl restart apache2";
        elif systemctl is-active --quiet httpd 2>/dev/null || command -v httpd >/dev/null 2>&1; then
            web_type="systemctl restart httpd";
            cmd_web="$runsudo systemctl restart httpd";
        fi
    else
        if command -v apachectl >/dev/null 2>&1; then
            web_type="apachectl graceful";
            cmd_web="$runsudo apachectl graceful";
        fi
    fi
fi

cmd_fpm=""
if [ "$(uname)" = "Darwin" ]; then
    fpm_pid=$(ps aux | grep -E "[p]hp-fpm: master|[p]hp-fpm --nodaemonize" | awk '{print $2}' | head -n 1)
    if [ -n "$fpm_pid" ]; then
        if [ -n "$runsudo" ]; then cmd_fpm="sudo kill -HUP $fpm_pid"; else cmd_fpm="kill -HUP $fpm_pid"; fi
    else
        if [ -n "$runsudo" ]; then cmd_fpm="sudo brew services restart php"; else cmd_fpm="brew services restart php"; fi
    fi
elif printf "%s" "$packm" | grep -q "apk"; then
    fpm_bin=$(find /usr/sbin -type f -name "php-fpm*" 2>/dev/null | head -n 1);
    if [ -n "$fpm_bin" ]; then if [ -n "$runsudo" ]; then cmd_fpm="sudo $fpm_bin -D"; else cmd_fpm="$fpm_bin -D"; fi; fi
else
    if command -v systemctl >/dev/null 2>&1; then
        php_maj_min=$(printf "%s" "$php_ver" | cut -d. -f1,2)
        if [ -n "$runsudo" ]; then cmd_fpm="sudo systemctl restart php-fpm (or php${php_maj_min}-fpm)"; else cmd_fpm="systemctl restart php-fpm (or php${php_maj_min}-fpm)"; fi
    fi
fi

if [ "$IS_JA" -eq 1 ]; then printf "%s\n" "$msg_exec_restart_ja"; else printf "%s\n" "$msg_exec_restart_en"; fi
[ -n "$cmd_update" ] && printf "  1. %s\n" "$cmd_update"
[ -n "$cmd_install" ] && printf "  2. %s\n" "$cmd_install"
[ -n "$cmd_web" ]     && printf "  3. %s\n" "$cmd_web"
[ -n "$cmd_fpm" ]     && printf "  4. %s\n" "$cmd_fpm"
printf "\n"

# ==========================================
# 5. アップデート直前の確認対話
# ==========================================
if [ "$IS_JA" -eq 1 ]; then
    printf "%s\n[Y/n]: " "$msg_confirm_ja"
else
    printf "%s\n[Y/n]: " "$msg_confirm_en"
fi

if stty -icanon -echo </dev/tty 2>/dev/null; then
    answer=$(dd bs=1 count=1 2>/dev/null </dev/tty)
    stty icanon echo </dev/tty
    printf "%s\n\n" "$answer"
else
    read answer
fi

case "$answer" in
    [nN]*)
        if [ "$IS_JA" -eq 1 ]; then printf "%s\n" "$msg_cancel_ja"; else printf "%s\n" "$msg_cancel_en"; fi
        exit 0
        ;;
esac

# ==========================================
# 6. 再起動・更新前の権限チェック
# ==========================================
if [ -n "$runsudo" ] && [ "$(whoami)" != "root" ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        if [ "$IS_JA" -eq 1 ]; then printf "%s\n" "$msg_no_perm_ja"; else printf "%s\n" "$msg_no_perm_en"; fi
        exit 1
    fi
fi

# ==========================================
# 7. パッチ適用処理
# ==========================================

# 7.1 リポジトリ更新の実行
if [ -n "$updatepm" ]; then
    if [ "$IS_JA" -eq 1 ]; then printf "$msg_apt_update_ja\n" "$updatepm"; else printf "$msg_apt_update_en\n" "$updatepm"; fi
    eval "$updatepm" >/dev/null 2>&1
fi

# 7.2 パッケージのインストール/アップグレード実行 (brewのWarningを通す構造)
if [ -n "$packm" ]; then
    if [ "$IS_JA" -eq 1 ]; then printf "$msg_apt_install_ja\n" "$cmd_install"; else printf "$msg_apt_install_en\n" "$cmd_install"; fi
    if [ -x "$(command -v apt)" ]; then
        eval "$cmd_install" >/dev/null 2>&1
    else
        if uname -a | grep -qiE 'Darwin'; then
            brew upgrade php >/dev/null
        else
            eval "$packm php" >/dev/null 2>&1
        fi
    fi
fi

# 7.3 Restart web server (only apache)
if [ -n "$cmd_web" ]; then
    eval "$cmd_web" >/dev/null 2>&1
    if [ "$IS_JA" -eq 1 ]; then
        printf "$msg_web_done_ja\n" "$web_type"
    else
        printf "$msg_web_done_en\n" "$web_type"
    fi
fi

# 7.4 Restart PHP-FPM
if [ -n "$cmd_fpm" ]; then
    if [ "$(uname)" = "Darwin" ]; then
        eval "$cmd_fpm" >/dev/null 2>&1
        if [ "$IS_JA" -eq 1 ]; then
            printf "%s\n" "$msg_macos_fpm_ja";
        else
            printf "%s\n" "$msg_macos_fpm_en";
        fi
    elif printf "%s" "$packm" | grep -q "apk"; then
        eval "$cmd_fpm" >/dev/null 2>&1
        if [ "$IS_JA" -eq 1 ]; then
            printf "$msg_alpine_fpm_ja\n" "$fpm_bin";
        else
            printf "$msg_alpine_fpm_en\n" "$fpm_bin";
        fi
    else
        if command -v systemctl >/dev/null 2>&1; then
            php_maj_min=$(printf "%s" "$php_ver" | cut -d. -f1,2)
            if [ -n "$runsudo" ]; then
                sudo systemctl restart php-fpm 2>/dev/null || sudo systemctl restart "php${php_maj_min}-fpm" 2>/dev/null
            else
                systemctl restart php-fpm 2>/dev/null || systemctl restart "php${php_maj_min}-fpm" 2>/dev/null
            fi
            if [ "$IS_JA" -eq 1 ]; then
                printf "%s\n" "$msg_linux_fpm_ja"
            else
                printf "%s\n" "$msg_linux_fpm_en"
            fi
        fi
    fi
fi



